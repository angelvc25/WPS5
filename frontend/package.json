{
  "name": "FifthStationUI",
  "main": "expo-router/entry",
  "version": "1.1.2",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "electron:start": "electron electron/main.js",
    "backend:dev": "npm --prefix ../backend run dev",
    "electron:dev": "concurrently \"npm run backend:dev\" \"npm run electron:start\"",
    "electron:build": "expo export -p web && electron-builder",
    "sync-music": "node scripts/sync-music.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "electron-serve": "^3.0.1",
    "expo": "~54.0.37",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-youtube-iframe": "^2.4.1",
    "win-media-control": "^0.1.1",
    "windows-media-sessions": "^1.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "graceful-fs": "^4.2.11",
    "music-metadata": "^11.12.3",
    "typescript": "~5.9.2",
    "wait-on": "^9.0.5"
  },
  "private": true,
  "build": {
    "appId": "com.fifthstationui.app",
    "productName": "FifthStation UI",
    "directories": {
      "output": "dist-electron"
    },
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "electron/**/*",
      "package.json",
      "node_modules/windows-media-sessions/**/*",
      "node_modules/win-media-control/**/*"
    ],
    "asarUnpack": [
      "node_modules/windows-media-sessions/bin/**",
      "node_modules/win-media-control/**"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/images/logo/ps5.ico"
    },
    "nsis": {
      "installerIcon": "assets/images/logo/ps5.ico",
      "uninstallerIcon": "assets/images/logo/ps5.ico",
      "installerHeaderIcon": "assets/images/logo/ps5.ico"
    }
  }
}