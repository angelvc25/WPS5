                          setSplashFocusZone('pager');
                          setSplashPagerIndex(0);
                          setSplashPage((p) => Math.max(1, p - 1));
                        }}
                      >
                        {isPagerFocused && splashPagerIndex === 0 && <SpinningBorderSettings size={s(140)} spread={0.5} borderRadius={0} />}
