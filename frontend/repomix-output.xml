                          <View style={uiStyles.albumCardOverlay}>
                            <Ionicons name="folder" size={s(24)} color="rgba(255,255,255,0.9)" />
                            <Text style={uiStyles.albumCardName} numberOfLines={1}>{album.name}</Text>
