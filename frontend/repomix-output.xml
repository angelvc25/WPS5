                      >
                        {isRowFocused && <SpinningBorderSettings size={s(160)} spread={0} borderRadius={1} />}
                        <View style={{ flex: 1 }}>
                          <Text style={styles.toggleRowTitle}>
                            {t(opt.labelKey as Parameters<typeof t>[0])}
