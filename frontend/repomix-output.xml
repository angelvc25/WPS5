                      <Text style={styles.syncItemLabel}>{pref.label}</Text>
                      <View style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 10 }}>
                        {options.map((opt) => (
                          <TouchableOpacity
                            key={opt.id}
                            style={[
                              styles.platformBtn,
