                    const isRowFocused = systemFocusArea === 'right' && subFocusIndex === optIdx;
                    return (
                      <TouchableOpacity
                        key={opt.id}
                        style={[
                          styles.toggleRowSection,
                          isSelected && styles.languageSelectRowActive,
