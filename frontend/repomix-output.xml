  formatMediaTime,
  getAppIconName,
  sendMediaControl,
  getMediaControlTarget,
  cleanAppName,
  SystemMediaSession,
} from '@/services/systemMediaService';
import { useTranslation } from '@/contexts/LanguageContext';
import { notifyNowPlayingToast } from '@/services/toastService';
