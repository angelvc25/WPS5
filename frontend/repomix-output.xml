                size={50}
                innerSize={40}
                borderRadius="50%"
              >
                <TouchableOpacity
                  style={[
                    styles.headerIconBtn,
                    focusArea === 'welcome_toolbar' && toolbarFocusIndex === idx && styles.headerIconBtnFocused,
