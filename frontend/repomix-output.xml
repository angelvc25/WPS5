                </View>
              </ScrollView>
            )}

            {systemLeftIndex === 3 && (
              <ScrollView showsVerticalScrollIndicator={false}>
                <Text style={styles.rightSectionTitle}>{t('settings.dateAndTime')}</Text>
                <View style={styles.infoRow}>
