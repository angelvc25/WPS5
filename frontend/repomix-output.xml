        setDetailVisible(false);
        libraryGridRef.current?.closeDetail();
        setIsLibraryDetailVisible(false);
        setFavoritesVisible(false);
        setRandomSelectorVisible(false);

        if (!result?.suspended) {
          setTimeout(() => {
