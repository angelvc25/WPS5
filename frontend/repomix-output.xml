                            styles.mediaCardLarge,
                            { width: s(320) },
                            isCardFocused && styles.mediaCardFocused,
                          ]}
                          onPress={() => {
                            setSplashFocusZone('grid');
                            setSplashGridFlatIndex(cardIdx);
                            openSplashPreview(post);
